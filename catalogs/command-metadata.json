    "time",
    "weather",
    "teleport",
    "summon",
    "title",
    "say",
    "msg",
    "tellraw"
  ],
  "hidden_commands": [
    "execute",
    "scoreboard",
    "bossbar",
    "attribute",
    "loot",
    "tellraw"
  ],
  "specs": {
    "give": {
      "label": "给予物品1",
      "fields": [
        {"name": "target", "type": "selector", "label": "目标", "default": "player_name", "required": true},
        {"name": "item", "type": "item", "label": "物品ID", "default": "minecraft:diamond_sword", "required": true},
        {"name": "count", "type": "int", "label": "数量", "default": "1", "min": 1, "max": 64}
      ]
    },
    "experience": {
      "label": "经验",
      "subcommands": {
        "add": {
          "label": "增加经验",
          "fields": [
            {"name": "target", "type": "selector", "label": "对象", "default": "player_name", "required": true},
            {"name": "amount", "type": "int", "label": "数量", "default": "10", "required": true}
          ]
        },
        "set": {
          "label": "设置经验",
          "fields": [
            {"name": "target", "type": "selector", "label": "对象", "default": "player_name", "required": true},
            {"name": "amount", "type": "int", "label": "经验值", "default": "100", "required": true}
          ]
        },
        "query": {
          "label": "查询经验",
          "fields": [
            {"name": "target", "type": "selector", "label": "对象", "default": "player_name", "required": true},
            {"name": "type", "type": "enum", "label": "类型", "default": "points", "options": ["points", "levels"], "required": true}
          ]
        }
      }
    },
    "effect": {
      "label": "状态效果",
      "subcommands": {
        "give": {
          "label": "给予效果",
          "fields": [
            {"name": "target", "type": "selector", "label": "对象", "default": "player_name", "required": true},
            {"name": "effect", "type": "effect", "label": "效果", "default": "minecraft:speed", "required": true},
            {"name": "seconds", "type": "int", "label": "秒数", "default": "30", "min": 1, "max": 100000},
            {"name": "amplifier", "type": "int", "label": "等级", "default": "0", "min": 0, "max": 255},
            {"name": "hideParticles", "type": "enum", "label": "粒子", "default": "true", "options": ["true", "false"]}
          ]
        },
        "clear": {
          "label": "清除效果",
          "fields": [
            {"name": "target", "type": "selector", "label": "对象", "default": "player_name", "required": true},
            {"name": "effect", "type": "effect", "label": "效果", "default": "minecraft:speed"}
          ]
        }
      }
    },
    "summon": {
      "label": "召唤实体",
      "fields": [
        {"name": "entity", "type": "entity", "label": "实体", "default": "minecraft:zombie", "required": true},
        {"name": "pos", "type": "pos", "label": "位置", "default": "~ ~1 ~", "required": true},
        {"name": "nbt", "type": "custom", "label": "NBT", "default": ""}
      ]
    },
    "teleport": {
      "label": "传送",
      "fields": [
        {"name": "targets", "type": "selector", "label": "目标", "default": "player_name", "required": true},
        {"name": "destination", "type": "pos", "label": "目的地", "default": "~ ~1 ~", "required": true}
      ]
    },
    "time": {
      "label": "时间",
      "subcommands": {
        "set": {
          "label": "设置时间",
          "fields": [
            {"name": "time", "type": "enum", "label": "时间", "default": "day", "options": ["day", "night", "midnight", "noon", "sunset", "sunrise"], "required": true}
          ]
        },
        "add": {
          "label": "增加时间",
          "fields": [
            {"name": "amount", "type": "int", "label": "增量", "default": "100", "required": true}
          ]
        },
        "query": {
          "label": "查询时间",
          "fields": [
            {"name": "type", "type": "enum", "label": "类型", "default": "daytime", "options": ["daytime", "gametime", "day"], "required": true}
          ]
        }
      }
    },
    "weather": {
      "label": "天气",
      "subcommands": {
        "clear": {"label": "晴天", "fields": [{"name": "duration", "type": "int", "label": "时长", "default": "6000"}]},
        "rain": {"label": "下雨", "fields": [{"name": "duration", "type": "int", "label": "时长", "default": "6000"}]},
        "thunder": {"label": "雷雨", "fields": [{"name": "duration", "type": "int", "label": "时长", "default": "6000"}]}
      }
    },
    "title": {
      "label": "标题",
      "subcommands": {
        "clear": {"label": "清除标题"},
        "reset": {"label": "重置标题"},
        "title": {"label": "主标题", "fields": [{"name": "player", "type": "selector", "label": "玩家", "default": "player_name"}, {"name": "json", "type": "json", "label": "标题内容", "default": "{\"text\":\"欢迎\"}"}]},
        "subtitle": {"label": "副标题", "fields": [{"name": "player", "type": "selector", "label": "玩家", "default": "player_name"}, {"name": "json", "type": "json", "label": "副标题", "default": "{\"text\":\"欢迎\"}"}]},
        "actionbar": {"label": "动作栏", "fields": [{"name": "player", "type": "selector", "label": "玩家", "default": "player_name"}, {"name": "json", "type": "json", "label": "文本", "default": "{\"text\":\"欢迎\"}"}]},
        "times": {"label": "动画时间", "fields": [{"name": "fadeIn", "type": "int", "label": "淡入", "default": "20"}, {"name": "stay", "type": "int", "label": "停留", "default": "60"}, {"name": "fadeOut", "type": "int", "label": "淡出", "default": "20"}]}
      }
    },
    "execute": {
      "label": "执行上下文",
      "subcommands": {
        "as": {"label": "以目标实体身份执行", "fields": [{"name": "target", "type": "selector", "label": "目标", "default": "player_name", "required": true}, {"name": "at", "type": "selector", "label": "附加位置", "default": "player_name"}]},
        "at": {"label": "在目标实体位置执行", "fields": [{"name": "target", "type": "selector", "label": "目标", "default": "player_name", "required": true}, {"name": "run", "type": "text", "label": "命令", "default": "say hello"}]},
        "run": {"label": "运行命令", "fields": [{"name": "command", "type": "text", "label": "命令", "default": "say hello", "required": true}]},
        "if": {"label": "条件判断", "fields": [{"name": "condition", "type": "text", "label": "条件", "default": "entity player_name", "required": true}]},
        "unless": {"label": "条件否定判断", "fields": [{"name": "condition", "type": "text", "label": "条件", "default": "entity player_name", "required": true}]},
        "positioned": {"label": "指定位置", "fields": [{"name": "pos", "type": "pos", "label": "坐标", "default": "~ ~1 ~", "required": true}]},
        "rotated": {"label": "指定旋转", "fields": [{"name": "rot", "type": "text", "label": "旋转", "default": "~ 90", "required": true}]}
      }
    },
    "scoreboard": {
      "label": "计分板",
      "subcommands": {
        "objectives": {
          "label": "目标管理",
          "subcommands": {
            "add": {"label": "新增目标", "fields": [{"name": "objective", "type": "text", "label": "目标名", "default": "deaths", "required": true}, {"name": "criterion", "type": "text", "label": "判定器", "default": "deathCount", "required": true}]},
            "list": {"label": "列出目标"},
            "remove": {"label": "删除目标", "fields": [{"name": "objective", "type": "text", "label": "目标名", "default": "deaths", "required": true}]}
          }
        },
        "players": {
          "label": "玩家分数",
          "subcommands": {
            "add": {"label": "增加分数", "fields": [{"name": "target", "type": "selector", "label": "玩家", "default": "player_name", "required": true}, {"name": "objective", "type": "text", "label": "目标", "default": "deaths", "required": true}, {"name": "score", "type": "int", "label": "分数", "default": "1", "required": true}]},
            "set": {"label": "设置分数", "fields": [{"name": "target", "type": "selector", "label": "玩家", "default": "player_name", "required": true}, {"name": "objective", "type": "text", "label": "目标", "default": "deaths", "required": true}, {"name": "score", "type": "int", "label": "分数", "default": "1", "required": true}]},
            "get": {"label": "查询分数", "fields": [{"name": "target", "type": "selector", "label": "玩家", "default": "player_name", "required": true}, {"name": "objective", "type": "text", "label": "目标", "default": "deaths", "required": true}]}
          }
        }
      }
    },
    "bossbar": {
      "label": "Boss栏",
      "subcommands": {
        "add": {"label": "新建Boss栏", "fields": [{"name": "id", "type": "text", "label": "Boss栏ID", "default": "boss1", "required": true}, {"name": "name", "type": "json", "label": "名称", "default": "{\"text\":\"Boss\"}"}]},
        "set": {"label": "设置Boss栏属性", "fields": [{"name": "id", "type": "text", "label": "Boss栏ID", "default": "boss1", "required": true}, {"name": "value", "type": "text", "label": "属性", "default": "name", "required": true}, {"name": "arg", "type": "text", "label": "参数", "default": "{\"text\":\"Boss\"}", "required": true}]},
        "remove": {"label": "移除Boss栏", "fields": [{"name": "id", "type": "text", "label": "Boss栏ID", "default": "boss1", "required": true}]}
      }
    },
    "attribute": {
      "label": "属性",
      "subcommands": {
        "get": {"label": "查询属性", "fields": [{"name": "target", "type": "selector", "label": "目标", "default": "player_name", "required": true}, {"name": "attribute", "type": "text", "label": "属性", "default": "minecraft:generic.attack_damage", "required": true}]},
        "set": {"label": "设置属性", "fields": [{"name": "target", "type": "selector", "label": "目标", "default": "player_name", "required": true}, {"name": "attribute", "type": "text", "label": "属性", "default": "minecraft:generic.attack_damage", "required": true}, {"name": "value", "type": "number", "label": "值", "default": "1.0", "required": true}]}
      }
    },
    "loot": {
      "label": "战利品",
      "subcommands": {
        "give": {"label": "给予战利品", "fields": [{"name": "targets", "type": "selector", "label": "目标", "default": "player_name", "required": true}, {"name": "loot_table", "type": "text", "label": "战利品表", "default": "minecraft:chests/simple_dungeon", "required": true}]},
        "spawn": {"label": "生成战利品", "fields": [{"name": "pos", "type": "pos", "label": "坐标", "default": "~ ~1 ~", "required": true}, {"name": "loot_table", "type": "text", "label": "战利品表", "default": "minecraft:chests/simple_dungeon", "required": true}]}
      }
    },
    "say": {"label": "广播消息", "fields": [{"name": "message", "type": "text", "label": "消息", "default": "hello", "required": true}]},
    "msg": {"label": "私聊", "fields": [{"name": "target", "type": "selector", "label": "目标", "default": "player_name", "required": true}, {"name": "message", "type": "text", "label": "消息", "default": "hello", "required": true}]},
    "tellraw": {"label": "JSON消息", "fields": [{"name": "target", "type": "selector", "label": "目标", "default": "player_name"}, {"name": "json", "type": "json", "label": "JSON", "default": "{\"text\":\"hello\"}", "required": true}]}
  }
}
